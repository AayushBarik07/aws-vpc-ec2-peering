# =============================================================================
# Standalone VPC Peering Lab — Variable Values Example
# =============================================================================

aws_region        = "eu-north-1"
availability_zone = "eu-north-1a"

vpc_a_cidr                = "10.10.0.0/16"
vpc_a_public_subnet_cidr  = "10.10.1.0/24"

vpc_b_cidr                = "10.20.0.0/16"
vpc_b_private_subnet_cidr = "10.20.1.0/24"

instance_type  = "t3.micro"
ssh_key_name   = "my-aws-ssh-key"
admin_ssh_cidr = "203.0.113.25/32" # Replace with your current workstation public IP (/32)

default_tags = {
  Project     = "AWS-VPC-Peering"
  Environment = "Lab"
  ManagedBy   = "Terraform"
}
